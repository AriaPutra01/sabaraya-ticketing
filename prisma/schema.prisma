datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  ADMIN
  EMPLOYEE
}

enum Division {
  IT
  TEKNISI
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REJECTED
}

model User {
  id               String             @id @default(uuid())
  name             String
  email            String             @unique
  passwordHash     String
  role             Role               @default(EMPLOYEE)
  division         Division?
  phone            String?
  isActive         Boolean            @default(true)
  maxActiveTickets Int                @default(5)
  schedules        EmployeeSchedule[]
  assignedTickets  Ticket[]           @relation("AssigneeTickets")
  activities       TicketActivity[]
  handledChats     ChatSession[]      @relation("AgentChatSessions")
  sessions         Session[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

model Region {
  id        String             @id @default(uuid())
  name      String             @unique
  coverage  String             // Deskripsi rinci cakupan area (kota/kabupaten yang dicakup)
  isActive  Boolean            @default(true)
  schedules EmployeeSchedule[]
  tickets   Ticket[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@map("regions")
}

model EmployeeSchedule {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  regionId  String
  region    Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([regionId, startTime, endTime])
  @@map("employee_schedules")
}

model Ticket {
  id              String           @id @default(uuid())
  code            String           @unique
  division        Division
  regionId        String
  region          Region           @relation(fields: [regionId], references: [id])
  institutionName String
  reporterName    String
  reporterPhone   String
  reporterAddress String?
  deviceBrand     String?
  serialNumber    String?
  title           String
  description     String
  photoUrl        String?
  photoUrls       String[]         @default([])
  priority        TicketPriority   @default(MEDIUM)
  status          TicketStatus     @default(PENDING)
  assigneeId      String?
  assignee        User?            @relation("AssigneeTickets", fields: [assigneeId], references: [id])
  assignedAt      DateTime?
  respondedAt     DateTime?
  resolvedAt      DateTime?
  rejectionReason String?
  resolutionNote  String?
  activities      TicketActivity[]
  chatSession     ChatSession?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, division, regionId])
  @@map("tickets")
}

model TicketActivity {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String
  action    String
  note      String?
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_activities")
}

enum ChatSessionStatus {
  BOT_ACTIVE
  WAITING_FOR_AGENT
  AGENT_ACTIVE
  CLOSED
}

enum MessageSender {
  USER
  BOT
  AGENT
  SYSTEM
}

model ChatSession {
  id           String            @id @default(uuid())
  sessionToken String            @unique
  ticketId     String?           @unique
  ticket       Ticket?           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userName     String?
  userContact  String?
  status       ChatSessionStatus @default(BOT_ACTIVE)
  assignedToId String?
  assignedTo   User?             @relation("AgentChatSessions", fields: [assignedToId], references: [id])
  messages     ChatMessage[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status, assignedToId])
  @@index([ticketId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String        @id @default(uuid())
  sessionId String
  session   ChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender    MessageSender
  senderId  String?
  content   String
  createdAt DateTime      @default(now())

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model KnowledgeDocument {
  id        String           @id @default(uuid())
  title     String
  category  String           @default("FAQ")
  content   String
  chunks    KnowledgeChunk[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         String                     @id @default(uuid())
  documentId String
  document   KnowledgeDocument          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                   @default(now())

  @@index([documentId])
  @@map("knowledge_chunks")
}

